# &.edu environment. Copy to .env (never commit .env) and fill in what you use; empty lines keep the defaults.

# --- model access ---
# Gemini API key (required for generation); api_KEY is read first
api_KEY=
# same key under its usual name, used when api_KEY is empty
GEMINI_API_KEY=
# comma-separated models for diagnostic, syllabus and answer checks (empty = built-in list)
SCIEDU_PLANNER_MODELS=
# comma-separated models for lessons, quizzes and practice (empty = built-in list)
SCIEDU_LESSON_MODELS=

# --- server ---
# listen address; anything but 127.0.0.1 requires SCIEDU_AUTH=1
SCIEDU_HOST=127.0.0.1
SCIEDU_PORT=8090
# 1 = accounts mode: every API call needs a login and courses are private to their owner
SCIEDU_AUTH=
# extra hostnames accepted in the Host header (localhost and 127.0.0.1 are always allowed), comma-separated
SCIEDU_ALLOWED_HOSTS=
# docker compose --profile tls: the public domain Caddy serves over HTTPS (also add it to SCIEDU_ALLOWED_HOSTS)
SCIEDU_DOMAIN=
# browser origins allowed by CORS, comma-separated
SCIEDU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# accounts mode: user ids (shown in the account menu) allowed to edit shared (non-course) topics and the catalog, comma-separated
SCIEDU_ADMINS=
# where the database, topics and notes live (empty = ./content)
SCIEDU_CONTENT_DIR=

# --- spending guards and features ---
# Gemini requests per day across all features, fallbacks included
SCIEDU_DAILY_MODEL_CALLS=400
# accounts mode: one student's share of that budget per day (default half of it; 0 = no per-student cap)
SCIEDU_USER_DAILY_MODEL_CALLS=
# multiplies the per-user hourly generation limits; 0 turns limiting off
SCIEDU_RATE_SCALE=1
# 0 = don't author simulations for new classes
SCIEDU_AUTHOR_SIMS=1
# 0 = check answer keys offline instead of against Google Search results
SCIEDU_GROUNDED_CHECKS=1

# --- spoken lectures (ElevenLabs; off by default, the browser voice is used) ---
# 1 = use ElevenLabs with the server key below
SCIEDU_ELEVENLABS=
ELEVENLABS_API_KEY=
# alternative names for the same key
ELEVEN_LABS_API_KEY=
XI_API_KEY=

# --- Antigravity CLI companion (personal machine only; never runs when SCIEDU_AUTH=1) ---
# 1 = route assistant prompts through the fenced agy agent
AGY_CLI=
# agy CLI runs per day
AGY_DAILY_RUNS=15
# path to the agy binary
AGY_BIN=/opt/homebrew/bin/agy

# --- MCP server (mcp_server.py) ---
# backend base URL (empty = http://127.0.0.1:8090)
ANDEDU_API=
# session token for accounts mode
ANDEDU_TOKEN=
